<div class="wrap section" style="max-width:26rem">
  <h1 class="serif" style="font-size:2rem">Sign in</h1>
  {%- form 'customer_login' -%}
    {{ form.errors | default_errors }}
    <label style="display:block;margin-top:1rem">Email<input type="email" name="customer[email]" class="input-cc" style="width:100%;border:1px solid var(--line-strong);border-radius:1rem;padding:.8rem 1rem;background:var(--cream-paper)" required></label>
    <label style="display:block;margin-top:1rem">Password<input type="password" name="customer[password]" style="width:100%;border:1px solid var(--line-strong);border-radius:1rem;padding:.8rem 1rem;background:var(--cream-paper)" required></label>
    <button type="submit" class="btn btn-cta mt-3 btn-block">Sign in</button>
  {%- endform -%}
  {%- form 'recover_customer_password' -%}
    {%- if form.posted_successfully? -%}<p class="muted mt-2">We've sent you a reset email.</p>{%- endif -%}
  {%- endform -%}
  <p class="muted mt-2" style="font-size:.85rem"><a href="{{ routes.account_register_url }}" style="color:var(--pink)">Create an account</a></p>
</div>
