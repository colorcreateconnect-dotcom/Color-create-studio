<div class="wrap section" style="max-width:26rem">
  <h1 class="serif" style="font-size:2rem">Reset password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label style="display:block;margin-top:1rem">New password<input type="password" name="customer[password]" style="width:100%;border:1px solid var(--line-strong);border-radius:1rem;padding:.8rem 1rem;background:var(--cream-paper)" required></label>
    <label style="display:block;margin-top:1rem">Confirm password<input type="password" name="customer[password_confirmation]" style="width:100%;border:1px solid var(--line-strong);border-radius:1rem;padding:.8rem 1rem;background:var(--cream-paper)" required></label>
    <button type="submit" class="btn btn-cta mt-3 btn-block">Reset password</button>
  {%- endform -%}
</div>
