{%- assign pack_product = all_products['sports-pack-order'] -%}
<section class="band-stadium section">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}
    <h2 class="serif mt-1" style="font-size:clamp(1.9rem,4vw,2.8rem);color:#fff">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <span class="chrome-text">{{ section.settings.heading_accent }}</span>{% endif %}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}<p style="color:#B9C9E8;max-width:40rem;margin-top:.5rem">{{ section.settings.intro }}</p>{%- endif -%}
    <div class="grid grid-3 mt-3">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pack' -%}
        <div style="border:1px solid rgba(147,197,253,.3);background:rgba(255,255,255,.06);border-radius:1.5rem;padding:1.5rem;color:#fff" {{ block.shopify_attributes }}>
          <div style="color:#93C5FD;font-weight:700;font-size:.85rem">From</div>
          <div class="serif" style="font-size:2rem">${{ block.settings.price }}</div>
          <h3 style="margin-top:.75rem;font-size:1.15rem">{{ block.settings.title }}</h3>
          <ul style="margin:.75rem 0 0;padding-left:1.1rem;color:#B9C9E8;font-size:.88rem;line-height:1.6">
            {%- assign items = block.settings.features | newline_to_br | split: '<br />' -%}
            {%- for it in items -%}{%- assign clean = it | strip -%}{%- if clean != blank -%}<li>{{ clean }}</li>{%- endif -%}{%- endfor -%}
          </ul>
          {%- if block.settings.turnaround != blank -%}
          <p style="margin-top:.9rem;border-top:1px solid rgba(255,255,255,.12);padding-top:.75rem;font-size:.75rem;color:#93C5FD;font-weight:700">Two design rounds &middot; {{ block.settings.turnaround }}</p>
          {%- endif -%}
          {%- if pack_product != blank and pack_product.available -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="mt-2">
            <input type="hidden" name="id" value="{{ pack_product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="{{ block.settings.price }}">
            <input type="hidden" name="return_to" value="/checkout">
            <input type="hidden" name="properties[Pack]" value="{{ block.settings.title | escape }}">
            <input type="hidden" name="properties[Order total]" value="${{ block.settings.price }}">
            <input class="f-in" name="properties[Player details]" placeholder="Player name, number, team &amp; colors" style="margin-bottom:.5rem">
            <button type="submit" class="btn btn-cta" style="width:100%">Order now &mdash; ${{ block.settings.price }}</button>
          </form>
          {%- else -%}
          <button type="button" class="btn btn-cta mt-2" onclick="ccPick('{{ block.settings.title | escape }}, ${{ block.settings.price }}','Player Pride',{{ block.settings.price }})">Start with this pack</button>
          {%- endif -%}
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="grid grid-4 mt-3">
      {%- for block in section.blocks -%}
        {%- if block.type == 'mini' -%}
        <div style="border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.25);border-radius:1.25rem;padding:1rem;color:#fff" {{ block.shopify_attributes }}>
          <div style="font-weight:700;font-size:.92rem">{{ block.settings.title }}</div>
          <div style="color:#93C5FD;font-weight:900;font-size:1.25rem;margin-top:.2rem">${{ block.settings.price }}</div>
          <div style="color:#B9C9E8;font-size:.78rem;margin-top:.4rem;line-height:1.5">{{ block.settings.contents }}</div>
          {%- if pack_product != blank and pack_product.available -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="mt-2">
            <input type="hidden" name="id" value="{{ pack_product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="{{ block.settings.price }}">
            <input type="hidden" name="return_to" value="/checkout">
            <input type="hidden" name="properties[Pack]" value="{{ block.settings.title | escape }}">
            <input type="hidden" name="properties[Order total]" value="${{ block.settings.price }}">
            <input class="f-in" name="properties[Player details]" placeholder="Player name, number, team" style="margin-bottom:.5rem;font-size:.85rem">
            <button type="submit" class="btn btn-cta" style="width:100%;font-size:.85rem">Order now &mdash; ${{ block.settings.price }}</button>
          </form>
          {%- endif -%}
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fan packs & keepsakes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Player Pride & Fan Support" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose how loudly" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (chrome)", "default": "the family shows up." },
    { "type": "textarea", "id": "intro", "label": "Intro text" }
  ],
  "blocks": [
    { "type": "pack", "name": "Fan pack", "settings": [
      { "type": "text", "id": "title", "label": "Pack name" },
      { "type": "number", "id": "price", "label": "Price (charged at checkout)", "default": 65 },
      { "type": "text", "id": "turnaround", "label": "Turnaround" },
      { "type": "textarea", "id": "features", "label": "What's included (one per line)" }
    ]},
    { "type": "mini", "name": "Keepsake mini pack", "settings": [
      { "type": "text", "id": "title", "label": "Pack name" },
      { "type": "number", "id": "price", "label": "Price (charged at checkout)", "default": 15 },
      { "type": "text", "id": "contents", "label": "Contents" }
    ]}
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Fan packs & keepsakes" }]
}
{% endschema %}
