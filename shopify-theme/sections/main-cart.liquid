<div class="wrap section">
  <h1 class="serif" style="font-size:clamp(2rem,4vw,2.8rem)">Your Bag</h1>

  {%- if cart.item_count == 0 -%}
    <p class="muted mt-2">Your blank canvas is still blank. Add something beautiful.</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-cta mt-2">Browse the studio</a>
  {%- else -%}
    {%- form 'cart', cart -%}
      <div class="mt-3">
        {%- for item in cart.items -%}
          <div class="cart-row">
            {%- if item.image != blank -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}">{%- else -%}<span></span>{%- endif -%}
            <div>
              <a href="{{ item.url }}" style="font-weight:600">{{ item.product.title }}</a>
              {%- unless item.variant.title contains 'Default' -%}<div class="muted" style="font-size:.85rem">{{ item.variant.title }}</div>{%- endunless -%}
              <div class="muted" style="font-size:.85rem">{{ item.final_price | money }} each</div>
              <a href="{{ item.url_to_remove }}" class="muted" style="font-size:.8rem;text-decoration:underline">Remove</a>
            </div>
            <div style="text-align:right">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:4rem;border:1px solid var(--line-strong);border-radius:.6rem;padding:.4rem">
              <div style="font-weight:700;margin-top:.4rem">{{ item.final_line_price | money }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-summary">
        <div style="display:flex;justify-content:space-between;font-size:1.2rem">
          <span>Subtotal</span><strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="muted mt-1" style="font-size:.85rem">Shipping &amp; taxes calculated at checkout.</p>
        <div style="display:flex;gap:.75rem;flex-wrap:wrap" class="mt-2">
          <button type="submit" name="update" class="btn btn-ghost">Update bag</button>
          <button type="submit" name="checkout" class="btn btn-cta" style="flex:1">Continue to checkout</button>
        </div>
      </div>
    {%- endform -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
