<div class="wrap section">
  <h1 class="serif" style="font-size:clamp(2rem,4vw,2.8rem)">Your Bag</h1>

  {%- if cart.item_count == 0 -%}
    <p class="muted mt-2">Your blank canvas is still blank. Add something beautiful.</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-cta mt-2">Browse the studio</a>
  {%- else -%}
    {%- comment -%}
      Order-unit products charge by quantity ($1 units), so their raw quantity is the
      dollar amount. Those lines hide the $1-each price and the quantity stepper, and
      show the real ordered quantity (from the Shirts property, else 1) plus the total.
    {%- endcomment -%}
    {%- assign order_unit_handles = 'custom-shirt-order,paper-lane-set-order,sports-pack-order,custom-project-inquiry,request-something-similar' | split: ',' -%}
    {%- form 'cart', cart -%}
      <div class="mt-3">
        {%- for item in cart.items -%}
          {%- assign is_order_line = false -%}
          {%- if order_unit_handles contains item.product.handle -%}{%- assign is_order_line = true -%}{%- endif -%}
          {%- assign real_qty = item.quantity -%}
          {%- if is_order_line -%}
            {%- assign real_qty = 1 -%}
            {%- for p in item.properties -%}{%- if p.first == 'Shirts' -%}{%- assign real_qty = p.last | times: 1 -%}{%- endif -%}{%- endfor -%}
            {%- if real_qty < 1 -%}{%- assign real_qty = 1 -%}{%- endif -%}
          {%- endif -%}
          <div class="cart-row">
            {%- if item.image != blank -%}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}">{%- else -%}<span></span>{%- endif -%}
            <div>
              {%- if is_order_line -%}
                <span style="font-weight:600">{{ item.product.title }}</span>
                {%- assign detail_bits = '' | split: ',' -%}
                {%- for p in item.properties -%}
                  {%- assign k = p.first -%}
                  {%- if k == 'Size' or k == 'Shirt color' or k == 'Print type' or k == 'Back graphic' or k == 'Pack' -%}
                    {%- assign v = p.last -%}
                    {%- if v != blank and v != 'None' -%}
                      {%- assign bit = v | append: '' | split: '|||' -%}
                      {%- assign detail_bits = detail_bits | concat: bit -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if detail_bits.size > 0 -%}<div class="muted" style="font-size:.85rem">{{ detail_bits | join: ' &middot; ' }}</div>{%- endif -%}
              {%- else -%}
                <a href="{{ item.url }}" style="font-weight:600">{{ item.product.title }}</a>
                {%- unless item.variant.title contains 'Default' -%}<div class="muted" style="font-size:.85rem">{{ item.variant.title }}</div>{%- endunless -%}
                <div class="muted" style="font-size:.85rem">{{ item.final_price | money }} each</div>
              {%- endif -%}
              <a href="{{ item.url_to_remove }}" class="muted" style="font-size:.8rem;text-decoration:underline">Remove</a>
            </div>
            <div style="text-align:right">
              {%- if is_order_line -%}
                <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                <div class="muted" style="font-size:.9rem">Qty {{ real_qty }}</div>
                <div style="font-weight:700;margin-top:.4rem">{{ item.final_line_price | money }}</div>
              {%- else -%}
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:4rem;border:1px solid var(--line-strong);border-radius:.6rem;padding:.4rem">
                <div style="font-weight:700;margin-top:.4rem">{{ item.final_line_price | money }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-summary">
        <div style="display:flex;justify-content:space-between;font-size:1.2rem">
          <span>Subtotal</span><strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="muted mt-1" style="font-size:.85rem">Shipping &amp; taxes calculated at checkout.</p>
        <div style="display:flex;gap:.75rem;flex-wrap:wrap" class="mt-2">
          <button type="submit" name="update" class="btn btn-ghost">Update bag</button>
          <button type="submit" name="checkout" class="btn btn-cta" style="flex:1">Continue to checkout</button>
        </div>
      </div>
    {%- endform -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
