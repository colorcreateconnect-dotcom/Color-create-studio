<section class="wrap section">
  {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
  {%- if section.settings.heading != blank -%}
  <h2 class="serif mt-1" style="font-size:clamp(1.7rem,3.5vw,2.4rem)">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <span class="tagline-gradient">{{ section.settings.heading_accent }}</span>{% endif %}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}<p class="muted mt-1" style="max-width:44rem">{{ section.settings.intro }}</p>{%- endif -%}
  <div class="grid grid-2 mt-3" style="gap:.75rem">
    {%- for block in section.blocks -%}
      <div class="card" style="padding:.85rem 1.1rem;display:flex;justify-content:space-between;gap:1rem;align-items:baseline" {{ block.shopify_attributes }}>
        <div>
          <div style="font-weight:600;font-size:.95rem">{{ block.settings.label }}</div>
          {%- if block.settings.note != blank -%}<div class="muted" style="font-size:.78rem;margin-top:.15rem">{{ block.settings.note }}</div>{%- endif -%}
        </div>
        <strong style="white-space:nowrap;color:var(--pink)">{{ block.settings.price }}</strong>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.settings.footnote != blank -%}<p class="muted mt-2" style="font-size:.82rem">{{ section.settings.footnote }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "Price list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (gradient)" },
    { "type": "textarea", "id": "intro", "label": "Intro text" },
    { "type": "textarea", "id": "footnote", "label": "Footnote" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "label", "label": "Item" },
      { "type": "text", "id": "price", "label": "Price text", "default": "$45" },
      { "type": "text", "id": "note", "label": "Small note" }
    ]}
  ],
  "max_blocks": 24,
  "presets": [{ "name": "Price list" }]
}
{% endschema %}
