{%- liquid
  assign img1 = section.settings.image_1
  assign img2 = section.settings.image_2
  assign img3 = section.settings.image_3
-%}
<section class="hero hero-paper" style="border-bottom:1px solid var(--line-strong)">
  <div class="wrap hero-grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="pill-live"><span class="blip"></span>{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="serif mt-2" style="max-width:24ch">{{ section.settings.heading }} <span class="tagline-gradient">{{ section.settings.heading_accent }}</span></h1>
      {%- if section.settings.subheading != blank -%}<p class="lede">{{ section.settings.subheading }}</p>{%- endif -%}
      <div class="hero-cta">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="btn btn-cta">{{ section.settings.button_label }} &rarr;</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a href="{{ section.settings.button2_url | default: '/collections/customs' }}" class="btn btn-ghost">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.fact_1 != blank or section.settings.fact_2 != blank -%}
        <div class="hero-facts">
          {%- if section.settings.fact_1 != blank -%}<span>{{ section.settings.fact_1 }}</span>{%- endif -%}
          {%- if section.settings.fact_1 != blank and section.settings.fact_2 != blank -%}<span class="dot"></span>{%- endif -%}
          {%- if section.settings.fact_2 != blank -%}<span>{{ section.settings.fact_2 }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero-stack" aria-hidden="true">
      <span class="hero-badge"><span class="script">{{ section.settings.badge | default: 'show up loud' }}</span></span>
      <figure class="hs1">{% if img1 %}<img src="{{ img1 | image_url: width: 600 }}" alt="">{% else %}<img src="{{ 'sports-jaylen-card.jpg' | asset_url }}" alt="">{% endif %}</figure>
      <figure class="hs2">{% if img2 %}<img src="{{ img2 | image_url: width: 600 }}" alt="">{% else %}<img src="{{ 'sports-jaylen-yardsign.jpg' | asset_url }}" alt="">{% endif %}</figure>
      <figure class="hs3">{% if img3 %}<img src="{{ img3 | image_url: width: 600 }}" alt="">{% else %}<img src="{{ 'sports-aymir-jersey.jpg' | asset_url }}" alt="">{% endif %}</figure>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow pill", "default": "Sports season · now booking" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your idea does not enter a template. It enters a" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (gradient)", "default": "creative process." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Custom apparel, celebration paper goods, sports graphics, and coordinated event pieces designed from a blank page for the person, team, or moment they belong to." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop firm-price products" },
    { "type": "url", "id": "button_url", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "Start a custom project" },
    { "type": "url", "id": "button2_url", "label": "Secondary button link" },
    { "type": "text", "id": "fact_1", "label": "Fact 1", "default": "Player cards · magazine-style spotlights" },
    { "type": "text", "id": "fact_2", "label": "Fact 2", "default": "Roster bundles · up to 14, one look" },
    { "type": "text", "id": "badge", "label": "Script badge", "default": "show up loud" },
    { "type": "image_picker", "id": "image_1", "label": "Collage image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Collage image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Collage image 3" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
