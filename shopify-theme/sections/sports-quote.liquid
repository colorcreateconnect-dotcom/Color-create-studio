{%- assign inquiry_product = all_products['custom-project-inquiry'] -%}
<section class="collection-head band-stadium">
  <div class="wrap">
    <span class="eyebrow">One team. Three ways to show up.</span>
    <h1 class="serif mt-1" style="font-size:clamp(2.4rem,5.5vw,4rem);line-height:.98">SHOW UP <span class="chrome-text">LOUD.</span></h1>
    <p class="muted mt-2" style="max-width:42rem;font-size:1.05rem">Player spotlights, supporter packs, team identity systems and roster bundles &mdash; one protected visual direction for the whole season.</p>
    <div class="mt-3"><a href="#sportsQuote" class="btn btn-cta">Start a Sports Project</a></div>
  </div>
</section>

<section class="wrap section">
  <span class="eyebrow">See the real thing</span>
  <h2 class="serif mt-1" style="font-size:clamp(1.9rem,4vw,2.8rem)">One player. <span class="tagline-gradient">A whole game-day look.</span></h2>
  <p class="muted mt-1" style="max-width:40rem">The Atlanta Spartans &ldquo;Hit Squad&rdquo; drop &mdash; one design carried across every piece, from the spotlight card to the fan in the stands.</p>
  <div class="grid grid-3 mt-3">
    {%- assign shots = 'sports-jaylen-card.jpg|Player card|Meet the Team,sports-jaylen-yardsign.jpg|Yard sign|Front-yard pride,sports-family-tees.jpg|Group tees|The whole squad,sports-magnet-badge.jpg|Magnet|Fridge keepsake,sports-magnet-contour.jpg|Contour magnet|Cut-to-shape,sports-face-fan.jpg|Game-day fan|Face on a stick' | split: ',' -%}
    {%- for s in shots -%}
      {%- assign parts = s | split: '|' -%}
      <div class="proof-cell" style="aspect-ratio:1;grid-row:auto">
        <img src="{{ parts[0] | asset_url }}" alt="{{ parts[2] }}" loading="lazy">
        <div class="cap"><div class="t" style="color:var(--teal)">{{ parts[1] }}</div><div class="n">{{ parts[2] }}</div></div>
      </div>
    {%- endfor -%}
  </div>
</section>

<section class="band-stadium section">
  <div class="wrap">
    <span class="eyebrow">Player Pride &amp; Fan Support</span>
    <h2 class="serif mt-1" style="font-size:clamp(1.9rem,4vw,2.8rem);color:#fff">Choose how loudly <span class="chrome-text">the family shows up.</span></h2>
    <div class="grid grid-3 mt-3">
      {%- assign i1 = '1 personalized supporter shirt~1 small player keepsake~Player name, number, sport, and team colors~1 coordinated design direction' -%}
      {%- assign i2 = 'Minimum 2 personalized supporter shirts~1 featured player keepsake~2 small keepsakes~1 coordinated player design direction' -%}
      {%- assign i3 = 'Minimum 4 personalized supporter shirts~1 premium player keepsake~4 small keepsakes~1 digital copy of approved artwork for personal social sharing~Priority scheduling' -%}
      {%- assign packs = 'Sideline Support Pack|65|5-7 business days|' | append: i1 | append: ',Player Pride Pack|145|7-10 business days|' | append: i2 | append: ',Full Family Fan Pack|295|10-15 business days|' | append: i3 | split: ',' -%}
      {%- for p in packs -%}
        {%- assign f = p | split: '|' -%}
        <div style="border:1px solid rgba(147,197,253,.3);background:rgba(255,255,255,.06);border-radius:1.5rem;padding:1.5rem;color:#fff">
          <div style="color:#93C5FD;font-weight:700;font-size:.85rem">From</div>
          <div class="serif" style="font-size:2rem">${{ f[1] }}</div>
          <h3 style="margin-top:.75rem;font-size:1.15rem">{{ f[0] }}</h3>
          <ul style="margin:.75rem 0 0;padding-left:1.1rem;color:#B9C9E8;font-size:.88rem;line-height:1.6">
            {%- assign items = f[3] | split: '~' -%}
            {%- for it in items -%}<li>{{ it }}</li>{%- endfor -%}
          </ul>
          <p style="margin-top:.9rem;border-top:1px solid rgba(255,255,255,.12);padding-top:.75rem;font-size:.75rem;color:#93C5FD;font-weight:700">Two design rounds &middot; {{ f[2] }}</p>
          <button type="button" class="btn btn-cta mt-2" onclick="ccPick('{{ f[0] }}, ${{ f[1] }}','Player Pride')">Start with this pack</button>
        </div>
      {%- endfor -%}
    </div>
    <div class="grid grid-4 mt-3">
      {%- assign minis = 'Mini Keepsake Pack|$15|Any 3 approved small items;Player Pocket Pack|$25|Keychain, magnet, button, 5 printed cards;Game-Day Extras Pack|$30|Can cooler, keychain, button, mini print, magnet;Grandstand Keepsake Pack|$40|8 x 10 print, keychain, magnet, button, 5 cards' | split: ';' -%}
      {%- for m in minis -%}
        {%- assign f = m | split: '|' -%}
        <div style="border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.25);border-radius:1.25rem;padding:1rem;color:#fff">
          <div style="font-weight:700;font-size:.92rem">{{ f[0] }}</div>
          <div style="color:#93C5FD;font-weight:900;font-size:1.25rem;margin-top:.2rem">{{ f[1] }}</div>
          <div style="color:#B9C9E8;font-size:.78rem;margin-top:.4rem;line-height:1.5">{{ f[2] }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="wrap section">
  <span class="eyebrow">Team Identity &amp; Social Graphics</span>
  <h2 class="serif mt-1" style="font-size:clamp(1.9rem,4vw,2.8rem)">One protected visual system <span class="tagline-gradient">for the season.</span></h2>
  <div class="grid grid-3 mt-3">
    {%- assign t1 = 'Up to 12 collectible player cards~Custom team visual direction~1 team roster graphic~1 complete season schedule graphic~1 team announcement or season-launch graphic~Social media-ready digital files' -%}
    {%- assign t2 = 'Up to 18 collectible player cards~1 team roster graphic~1 complete season schedule graphic~4 game-day graphics~2 final-score graphics~2 player spotlight or MVP graphics~1 reusable birthday graphic~1 sponsor recognition graphic~Social media-ready digital files' -%}
    {%- assign t3 = 'Up to 18 collectible player cards~Roster and complete season schedule graphics~6 game-day and 3 final-score graphics~3 player recognition graphics~Birthday, playoff, championship, and coach appreciation graphics~Up to 2 sponsor graphics~Banquet invitation and welcome or recap graphic~Social media-ready digital files' -%}
    {%- assign tp1 = 'Rookie Team Package|395|10-15 business days|' | append: t1 -%}
    {%- assign tp2 = 'All-Star Team Package|750|Initial identity, then approved content schedule|' | append: t2 -%}
    {%- assign tp3 = 'Championship Season Package|1050|Priority season scheduling with approved milestones|' | append: t3 -%}
    {%- assign tlist = tp1 | append: '@@' | append: tp2 | append: '@@' | append: tp3 | split: '@@' -%}
    {%- for p in tlist -%}
      {%- assign f = p | split: '|' -%}
      <div class="card" style="padding:1.5rem">
        <div style="color:var(--pink);font-weight:700;font-size:.85rem">From</div>
        <div class="serif" style="font-size:2rem">${{ f[1] }}</div>
        <h3 style="margin-top:.75rem;font-size:1.15rem">{{ f[0] }}</h3>
        <ul style="margin:.75rem 0 0;padding-left:1.1rem;color:var(--cocoa-soft);font-size:.88rem;line-height:1.6">
          {%- assign items = f[3] | split: '~' -%}
          {%- for it in items -%}<li>{{ it }}</li>{%- endfor -%}
        </ul>
        <p class="muted" style="margin-top:.9rem;border-top:1px solid var(--line);padding-top:.75rem;font-size:.78rem;font-weight:700">Two design rounds &middot; {{ f[2] }}</p>
        <button type="button" class="btn btn-cta mt-2" onclick="ccPick('{{ f[0] }}, ${{ f[1] }}','Team Identity')">Start with this package</button>
      </div>
    {%- endfor -%}
  </div>
  <div class="grid mt-3" style="grid-template-columns:repeat(2,1fr);gap:.75rem">
    {%- assign addons = 'Additional player card|$15;Schedule update|$5;Game-day graphic|$12;Player spotlight|$15;Additional schedule|$30;Sponsor announcement|$18;Quick Update Pack|$25;Game Week Pack|$50;Banquet & Awards Pack|$95;Season Extension Pack|$100' | split: ';' -%}
    {%- for a in addons -%}
      {%- assign f = a | split: '|' -%}
      <div style="border:1px solid var(--line);background:var(--cream-paper);border-radius:1rem;padding:.9rem;display:flex;justify-content:space-between;gap:.5rem"><span style="font-size:.88rem;font-weight:600">{{ f[0] }}</span><strong style="color:var(--pink)">{{ f[1] }}</strong></div>
    {%- endfor -%}
  </div>
</section>

<section class="band-stadium section">
  <div class="wrap">
    <span class="eyebrow">Build Your Team</span>
    <h2 class="serif mt-1" style="font-size:clamp(1.9rem,4vw,2.8rem);color:#fff">One roster. <span class="chrome-text">One running total.</span></h2>
    <p style="color:#B9C9E8;max-width:40rem;margin-top:.5rem">14-shirt minimum. Sizes and personalization included &mdash; every bundle prices clean: a base plus a flat rate per extra shirt. Bundle turnaround: 7-10 business days after approval.</p>
    <div class="grid grid-3 mt-3">
      {%- assign bundles = 'DTF Graphic + 14 Shirts|270|15;3D Full-Front 14 Shirts|420|30;3D Front-and-Back 14 Shirts|630|45' | split: ';' -%}
      {%- for b in bundles -%}
        {%- assign f = b | split: '|' -%}
        <div style="border:1px solid rgba(147,197,253,.3);background:rgba(255,255,255,.06);border-radius:1.5rem;padding:1.5rem;color:#fff">
          <h3 style="font-size:1.1rem">{{ f[0] }}</h3>
          <div class="serif" style="font-size:2rem;margin-top:.5rem">${{ f[1] }}</div>
          <p style="color:#B9C9E8;font-size:.85rem;margin-top:.5rem">+ ${{ f[2] }} per shirt beyond 14 &middot; sizes &amp; personalization included</p>
          <button type="button" class="btn btn-cta mt-2" onclick="ccPick('{{ f[0] }} bundle, ${{ f[1] }} + ${{ f[2] }}/extra shirt (send roster: names, numbers, sizes)','Full Team Takeover')">Start this bundle</button>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="wrap section" style="max-width:52rem" id="sportsQuote">
  <h2 class="serif" style="font-size:clamp(1.9rem,4vw,2.6rem)">Start your sports project.</h2>
  <p class="muted mt-1">Pick a pack above or describe your own &mdash; roster details, team colors, and reference photos welcome.</p>
  {%- if inquiry_product != blank and inquiry_product.available -%}
    {%- render 'inquiry-form', variant_id: inquiry_product.selected_or_first_available_variant.id -%}
  {%- else -%}
    <a href="/pages/start-a-project" class="btn btn-cta mt-2">Start a Project</a>
  {%- endif -%}
</section>

<script>
(function(){
  var occ = document.getElementById('ccOccasion'), svc = document.getElementById('ccService');
  if(occ) occ.value = 'Sports Social Studio';
  if(svc) svc.value = 'Player Pride';
})();
function ccPick(text, service){
  var t = document.querySelector('[name="properties[Requested pieces]"]');
  if(t){ t.value = (t.value ? t.value + '\n' : '') + 'Selected: ' + text; }
  var svc = document.getElementById('ccService');
  if(svc && service) svc.value = service;
  var q = document.getElementById('sportsQuote') || document.getElementById('deptQuote');
  if(q) q.scrollIntoView({behavior:'smooth'});
}
</script>

{% schema %}
{ "name": "Sports quote page", "settings": [] }
{% endschema %}
