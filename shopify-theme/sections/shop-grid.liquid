{%- assign col = section.settings.collection -%}
<section class="wrap section">
  {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
  {%- if section.settings.heading != blank -%}
  <h2 class="serif mt-1" style="font-size:clamp(1.9rem,4vw,2.8rem)">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <span class="tagline-gradient">{{ section.settings.heading_accent }}</span>{% endif %}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}<p class="muted mt-1" style="max-width:40rem">{{ section.settings.intro }}</p>{%- endif -%}
  {%- if col != blank and col.products.size > 0 -%}
    <div class="grid grid-4 mt-3">
      {%- for product in col.products limit: section.settings.limit -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
    <div class="mt-3"><a href="{{ col.url }}" class="btn btn-ghost">{{ section.settings.button_label | default: 'Shop the collection' }}</a></div>
  {%- elsif section.settings.empty_text != blank -%}
    <div class="card mt-3" style="padding:1.1rem 1.25rem;border-color:var(--gold-soft);background:#FBF6E9">{{ section.settings.empty_text }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Shop grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection to show" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (gradient)" },
    { "type": "textarea", "id": "intro", "label": "Intro text" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "textarea", "id": "empty_text", "label": "Text when collection is empty" }
  ],
  "presets": [{ "name": "Shop grid" }]
}
{% endschema %}
