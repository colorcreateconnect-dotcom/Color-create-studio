<section class="band-stadium section">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}
    <h2 class="serif mt-1" style="font-size:clamp(1.9rem,4vw,2.8rem);color:#fff">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <span class="chrome-text">{{ section.settings.heading_accent }}</span>{% endif %}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}<p style="color:#B9C9E8;max-width:40rem;margin-top:.5rem">{{ section.settings.intro }}</p>{%- endif -%}
    <div class="grid grid-3 mt-3">
      {%- for block in section.blocks -%}
        <div style="border:1px solid rgba(147,197,253,.3);background:rgba(255,255,255,.06);border-radius:1.5rem;padding:1.5rem;color:#fff" {{ block.shopify_attributes }}>
          <h3 style="font-size:1.1rem">{{ block.settings.title }}</h3>
          <div class="serif" style="font-size:2rem;margin-top:.5rem">${{ block.settings.price }}</div>
          <p style="color:#B9C9E8;font-size:.85rem;margin-top:.5rem">+ ${{ block.settings.per_extra }} per shirt beyond 14 &middot; sizes &amp; personalization included</p>
          <button type="button" class="btn btn-cta mt-2" onclick="ccPick('{{ block.settings.title | escape }} bundle, ${{ block.settings.price }} + ${{ block.settings.per_extra }}/extra shirt (send roster: names, numbers, sizes)','Full Team Takeover',{{ block.settings.price }})">Start this bundle</button>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Team bundles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build Your Team" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One roster." },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (chrome)", "default": "One running total." },
    { "type": "textarea", "id": "intro", "label": "Intro text" }
  ],
  "blocks": [
    { "type": "bundle", "name": "Bundle", "settings": [
      { "type": "text", "id": "title", "label": "Bundle name" },
      { "type": "number", "id": "price", "label": "Base price (drives the 50% deposit)", "default": 270 },
      { "type": "number", "id": "per_extra", "label": "Price per extra shirt", "default": 15 }
    ]}
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Team bundles" }]
}
{% endschema %}
