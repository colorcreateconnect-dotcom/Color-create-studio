<section class="wrap section">
  {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
  {%- if section.settings.heading != blank -%}
  <h2 class="serif mt-1" style="font-size:clamp(1.9rem,4vw,2.8rem)">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <span class="tagline-gradient">{{ section.settings.heading_accent }}</span>{% endif %}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}<p class="muted mt-1" style="max-width:40rem">{{ section.settings.intro }}</p>{%- endif -%}
  <div class="grid grid-3 mt-3">
    {%- for block in section.blocks -%}
      {%- if block.type == 'package' -%}
      <div class="card" style="padding:1.5rem" {{ block.shopify_attributes }}>
        <div style="color:var(--pink);font-weight:700;font-size:.85rem">From</div>
        <div class="serif" style="font-size:2rem">${{ block.settings.price }}</div>
        <h3 style="margin-top:.75rem;font-size:1.15rem">{{ block.settings.title }}</h3>
        <ul style="margin:.75rem 0 0;padding-left:1.1rem;color:var(--cocoa-soft);font-size:.88rem;line-height:1.6">
          {%- assign items = block.settings.features | newline_to_br | split: '<br />' -%}
          {%- for it in items -%}{%- assign clean = it | strip -%}{%- if clean != blank -%}<li>{{ clean }}</li>{%- endif -%}{%- endfor -%}
        </ul>
        {%- if block.settings.turnaround != blank -%}
        <p class="muted" style="margin-top:.9rem;border-top:1px solid var(--line);padding-top:.75rem;font-size:.78rem;font-weight:700">Two design rounds &middot; {{ block.settings.turnaround }}</p>
        {%- endif -%}
        <button type="button" class="btn btn-cta mt-2" onclick="ccPick('{{ block.settings.title | escape }}, ${{ block.settings.price }}','Team Identity',{{ block.settings.price }})">Start with this package</button>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="grid mt-3" style="grid-template-columns:repeat(2,1fr);gap:.75rem">
    {%- for block in section.blocks -%}
      {%- if block.type == 'addon' -%}
      <div style="border:1px solid var(--line);background:var(--cream-paper);border-radius:1rem;padding:.9rem;display:flex;justify-content:space-between;gap:.5rem" {{ block.shopify_attributes }}><span style="font-size:.88rem;font-weight:600">{{ block.settings.title }}</span><strong style="color:var(--pink)">{{ block.settings.price }}</strong></div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Team identity packages",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Team Identity & Social Graphics" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One protected visual system" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (gradient)", "default": "for the season." },
    { "type": "textarea", "id": "intro", "label": "Intro text" }
  ],
  "blocks": [
    { "type": "package", "name": "Package", "settings": [
      { "type": "text", "id": "title", "label": "Package name" },
      { "type": "number", "id": "price", "label": "From price (drives the 50% deposit)", "default": 395 },
      { "type": "text", "id": "turnaround", "label": "Turnaround / note" },
      { "type": "textarea", "id": "features", "label": "What's included (one per line)" }
    ]},
    { "type": "addon", "name": "Add-on", "settings": [
      { "type": "text", "id": "title", "label": "Add-on name" },
      { "type": "text", "id": "price", "label": "Price label", "default": "$15" }
    ]}
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Team identity packages" }]
}
{% endschema %}
