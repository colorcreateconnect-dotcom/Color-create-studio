<section class="section {{ section.settings.band }}">
  <div class="wrap">
    <div style="display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="serif mt-2" style="font-size:clamp(2rem,4vw,3rem)">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: '#' }}" class="btn btn-ghost">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <div class="proof">
      {%- for block in section.blocks -%}
        <figure {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.caption | escape }}" loading="lazy">
          {%- elsif block.settings.asset != blank -%}
            <img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.caption | escape }}" loading="lazy">
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption class="label" style="padding:.6rem .8rem;color:var(--cocoa)">{{ block.settings.caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Portfolio strip",
  "settings": [
    { "type": "select", "id": "band", "label": "Background band", "options": [
      { "value": "", "label": "Cream" },
      { "value": "band-sage", "label": "Sage" },
      { "value": "band-blush", "label": "Blush" }
    ], "default": "band-sage" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Portfolio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real work, real moments" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See more" },
    { "type": "url", "id": "link_url", "label": "Link url" }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "asset", "label": "Bundled asset filename (fallback)" },
      { "type": "text", "id": "caption", "label": "Caption" }
    ]}
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Portfolio strip", "blocks": [
    { "type": "photo", "settings": { "asset": "grad-jayvon-apparel.jpg", "caption": "Graduation" } },
    { "type": "photo", "settings": { "asset": "sports-jaylen-card.jpg", "caption": "Sports" } },
    { "type": "photo", "settings": { "asset": "birthday-brianna-brunch.jpg", "caption": "Birthday" } },
    { "type": "photo", "settings": { "asset": "reveal-babybee-invite.jpg", "caption": "Reveal" } },
    { "type": "photo", "settings": { "asset": "party-dukes-boots.jpg", "caption": "Party" } },
    { "type": "photo", "settings": { "asset": "apparel-topshelf.jpg", "caption": "Apparel" } }
  ]}]
}
{% endschema %}
