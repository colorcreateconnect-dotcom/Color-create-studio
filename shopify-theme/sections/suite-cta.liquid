<section class="band-sage section">
  <div class="wrap">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="serif mt-1" style="font-size:clamp(1.9rem,4vw,2.8rem)">{{ section.settings.heading }} <span class="tagline-gradient">{{ section.settings.heading_accent }}</span></h2>
    <p class="muted mt-1" style="max-width:40rem">{{ section.settings.subheading }}</p>
    <div class="mt-2" style="display:flex;flex-wrap:wrap;gap:.5rem">
      {%- assign pieces = 'Welcome sign,Invitations,Custom shirt,Cupcake toppers,Water bottle labels,Treat bags,Favor tags,Thank-you cards,Banner,Yard sign,Photo keepsake' | split: ',' -%}
      {%- for p in pieces -%}<span class="chip">{{ p }}</span>{%- endfor -%}
    </div>
    <div class="mt-3" style="display:flex;gap:.75rem;flex-wrap:wrap">
      <a href="/pages/celebration-suites#suitePicker" class="btn btn-cta">Build your suite</a>
      <a href="/collections/bundles" class="btn btn-ghost">Shop ready-made bundles</a>
      <a href="/pages/start-a-project" class="btn btn-ghost">Start a project</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Suite invite",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two or more pieces build a moment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Turn this collection" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "into a full suite." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "It works just like the shirt builder: tap the pieces your moment needs, send the suite to the studio with your theme and dates, and pay the deposit — apparel, paper, and keepsakes designed as one story." }
  ],
  "presets": [{ "name": "Suite invite" }]
}
{% endschema %}
