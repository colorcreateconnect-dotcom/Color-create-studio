{%- if section.settings.show_head -%}
<div class="collection-head {{ section.settings.band }}">
  <div class="wrap">
    <span class="eyebrow">Collection</span>
    <h1 class="serif mt-1">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="muted mt-1" style="max-width:42rem">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

<div class="wrap section">
  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      <div class="grid grid-3">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="center mt-4" style="display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="chip">{{ part.title }}</a>
            {%- else -%}
              <span class="chip chip-active">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="muted">No products in this collection yet.</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "checkbox", "id": "show_head", "label": "Show collection header", "default": true },
    { "type": "select", "id": "band", "label": "Header band", "options": [
      { "value": "band-mix", "label": "Mixed" },
      { "value": "band-sage", "label": "Sage" },
      { "value": "band-blush", "label": "Blush" },
      { "value": "", "label": "Cream" }
    ], "default": "band-mix" }
  ]
}
{% endschema %}
