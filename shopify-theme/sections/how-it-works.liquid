<section class="section band-sage" style="border-top:1px solid var(--line-strong);border-bottom:1px solid var(--line-strong)">
  <div class="wrap">
    <div style="margin-bottom:1.75rem">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="serif mt-2" style="font-size:clamp(1.7rem,3.5vw,2.4rem)">{{ section.settings.heading }}</h2>
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          <div class="n">{{ block.settings.number }}</div>
          <div class="l">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="muted mt-3" style="font-size:.9rem">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One item shops directly. Two or more build a moment." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "One firm-price item: customize it, add it to the bag, and continue to checkout. Celebration Suites: begin with two distinct coordinated item types. Larger packages and items without an approved firm price receive a clear quote before production." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "01" },
      { "type": "text", "id": "text", "label": "Text", "default": "Choose the lane." }
    ]}
  ],
  "max_blocks": 6,
  "presets": [{ "name": "How it works", "blocks": [
    { "type": "step", "settings": { "number": "01", "text": "Choose the lane." } },
    { "type": "step", "settings": { "number": "02", "text": "Customize one product or build a coordinated suite." } },
    { "type": "step", "settings": { "number": "03", "text": "Review every selected detail." } },
    { "type": "step", "settings": { "number": "04", "text": "Add the customized item to your bag or send the project to the studio." } },
    { "type": "step", "settings": { "number": "05", "text": "Approve the proof, then we produce." } }
  ]}]
}
{% endschema %}
