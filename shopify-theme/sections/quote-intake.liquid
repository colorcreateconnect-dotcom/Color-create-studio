{%- assign inquiry_product = all_products['custom-project-inquiry'] -%}
<section class="wrap section" style="max-width:52rem" id="deptQuote">
  <h2 class="serif" style="font-size:clamp(1.9rem,4vw,2.6rem)">{{ section.settings.heading | default: 'Start your project.' }}</h2>
  {%- if section.settings.intro != blank -%}<p class="muted mt-1">{{ section.settings.intro }}</p>{%- endif -%}
  {%- if inquiry_product != blank and inquiry_product.available -%}
    {%- render 'inquiry-form', variant_id: inquiry_product.selected_or_first_available_variant.id -%}
  {%- else -%}
    <a href="/pages/start-a-project" class="btn btn-cta mt-2">Start a Project</a>
  {%- endif -%}
</section>

<script>
(function(){
  var occ = document.getElementById('ccOccasion'), svc = document.getElementById('ccService');
  {% if section.settings.occasion != blank %}if(occ) occ.value = {{ section.settings.occasion | json }};{% endif %}
  {% if section.settings.service != blank %}if(svc) svc.value = {{ section.settings.service | json }};{% endif %}
})();
window.ccPick = function(text, service, price){
  var t = document.querySelector('[name="properties[Requested pieces]"]');
  if(t){ t.value = (t.value ? t.value + '\n' : '') + 'Selected: ' + text; }
  var svc = document.getElementById('ccService');
  if(svc && service) svc.value = service;
  if(price && window.ccSetDeposit) window.ccSetDeposit(price);
  var q = document.getElementById('deptQuote');
  if(q) q.scrollIntoView({behavior:'smooth'});
};
</script>

{% schema %}
{
  "name": "Quote intake",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start your project." },
    { "type": "textarea", "id": "intro", "label": "Intro text" },
    { "type": "text", "id": "occasion", "label": "Preselect moment", "info": "Must exactly match a Moment option, e.g. Sports Social Studio" },
    { "type": "text", "id": "service", "label": "Preselect service", "info": "Must exactly match a Service option, e.g. Player Pride" }
  ],
  "presets": [{ "name": "Quote intake" }]
}
{% endschema %}
