{%- assign inquiry_product = all_products['custom-project-inquiry'] -%}
<section class="collection-head band-blush">
  <div class="wrap">
    <span class="eyebrow">Party details with a point of view</span>
    <h1 class="serif mt-1" style="font-size:clamp(2.4rem,5.5vw,4rem);line-height:.98">Paper <span class="tagline-gradient">Lane.</span></h1>
    <p class="muted mt-2" style="max-width:42rem;font-size:1.05rem">One original design can travel across invitations, cards, decor, and table details without losing the thread. Sets of 12, printed or digital.</p>
    <div class="mt-3" style="display:flex;gap:.75rem;flex-wrap:wrap">
      <a href="#paperQuote" class="btn btn-cta">Start a custom set</a>
      <a href="/collections/paper-lane" class="btn btn-ghost">Shop ready-to-order paper</a>
    </div>
  </div>
</section>

{%- assign shop_col = collections['paper-lane'] -%}
{%- if shop_col != blank and shop_col.products.size > 0 -%}
<section class="wrap section">
  <span class="eyebrow">Shop Paper Lane</span>
  <h2 class="serif mt-1" style="font-size:clamp(1.9rem,4vw,2.8rem)">Ready-to-order <span class="tagline-gradient">paper goods.</span></h2>
  <p class="muted mt-1" style="max-width:40rem">Every tile is a real product &mdash; pick your set, personalize it, and check out at full price. Want a set designed from scratch? Start below.</p>
  <div class="grid grid-4 mt-3">
    {%- for product in shop_col.products limit: 8 -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}
  </div>
  <div class="mt-3"><a href="{{ shop_col.url }}" class="btn btn-ghost">Shop all {{ shop_col.products_count }} paper pieces</a></div>
</section>
{%- endif -%}

<section class="wrap section">
  <div class="card" style="padding:1.1rem 1.25rem;margin-bottom:1.5rem;border-color:var(--gold-soft);background:#FBF6E9">
    <strong>Smooth matte cardstock is our included standard.</strong>
    <span class="muted" style="font-size:.9rem"> Glitter, lamination, layered builds, and specialty papers add $25 per dozen. True metallic foil is quoted.</span>
  </div>

  <div class="grid grid-2">
    {%- assign lanes = 'Printed Party Invitations|21|18|15|Blank envelopes included|5 x 7 flat, 110 lb smooth matte cardstock, single-sided, blank envelopes included;Printed Custom Cards|18|15|10|Blank envelopes included|5 x 7 flat, 110 lb cardstock, blank envelopes included;Cupcake Toppers|10|8|10|Assembled with food-safe picks|2 inch rounds, up to 2 cardstock layers, assembled on food-safe picks;Personalized Treat Bags|16|13|10|Decorated empty bags, candy not included|5 x 7.5 inch decorated kraft bags, delivered empty;Drink Wrappers / Water Bottle Labels|10|8|10|Labels only|8.062 x 2.125 inch waterproof labels, fits standard 16.9 oz bottles;Personalized Place Cards|12|9|10|Guest names included|2 x 3.5 inch tent-folded, guest names printed;Favor Tags|15|12|10|Hole punch and twine included|2 x 3.5 inch, hole punched, bakers twine included;Thank-You Cards|15|12|10|Blank envelopes included|4.25 x 5.5 folded, 110 lb cardstock, blank envelopes included' | split: ';' -%}
    {%- for lane in lanes -%}
      {%- assign f = lane | split: '|' -%}
      <div class="card" style="padding:1.25rem;position:relative">
        <span style="position:absolute;right:.9rem;top:.9rem;transform:rotate(3deg);background:var(--gold-soft);color:var(--cocoa-deep);border-radius:9999px;padding:.25rem .7rem;font-family:var(--font-label);font-size:.6rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase">Set of 12</span>
        <h3 style="max-width:70%;font-size:1.05rem;font-weight:700">{{ f[0] }}</h3>
        <div class="serif" style="font-size:1.9rem;margin-top:.6rem">${{ f[1] }}</div>
        <div class="muted" style="font-size:.82rem">Additional 12, ${{ f[2] }} &middot; Digital file, ${{ f[3] }}</div>
        <div class="muted" style="margin-top:.6rem;border-top:1px solid var(--line);padding-top:.6rem;font-size:.8rem;line-height:1.5">{{ f[5] }}</div>
        <div class="muted" style="font-size:.78rem;margin-top:.3rem"><em>{{ f[4] }}</em></div>
        <button type="button" class="btn btn-ghost mt-2" onclick="ccPick('{{ f[0] }} — set of 12, ${{ f[1] }} printed (extra dozen ${{ f[2] }}) or ${{ f[3] }} digital','Paper Lane',{{ f[1] }})">Start this set</button>
      </div>
    {%- endfor -%}
  </div>

  <p class="muted mt-3" style="font-size:.9rem">Printed sets: 5-7 business days. Digital files: 3-5 business days, delivered by email after proof approval, personal use only. Quantities run in dozens (12, 24, 36, 48, 60) &mdash; need more than 60? That routes to a quote.</p>
</section>

<section class="wrap section" style="max-width:52rem" id="paperQuote">
  <h2 class="serif" style="font-size:clamp(1.9rem,4vw,2.6rem)">Start your paper set.</h2>
  <p class="muted mt-1">Pick a lane above or describe the set your moment needs &mdash; theme, colors, wording, and quantity in dozens.</p>
  {%- if inquiry_product != blank and inquiry_product.available -%}
    {%- render 'inquiry-form', variant_id: inquiry_product.selected_or_first_available_variant.id -%}
  {%- else -%}
    <a href="/pages/start-a-project" class="btn btn-cta mt-2">Start a Project</a>
  {%- endif -%}
</section>

<script>
(function(){
  var svc = document.getElementById('ccService');
  if(svc) svc.value = 'Paper Lane';
})();
function ccPick(text, service, price){
  var t = document.querySelector('[name="properties[Requested pieces]"]');
  if(t){ t.value = (t.value ? t.value + '\n' : '') + 'Selected: ' + text; }
  var svc = document.getElementById('ccService');
  if(svc && service) svc.value = service;
  if(price && window.ccSetDeposit) window.ccSetDeposit(price);
  var q = document.getElementById('paperQuote');
  if(q) q.scrollIntoView({behavior:'smooth'});
}
</script>

{% schema %}
{ "name": "Paper Lane quote page", "settings": [] }
{% endschema %}
