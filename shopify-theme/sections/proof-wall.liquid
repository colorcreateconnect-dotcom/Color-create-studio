<section class="section">
  <div class="wrap">
    <div style="display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:2rem">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="serif mt-2" style="font-size:clamp(2rem,4.5vw,3rem)">{{ section.settings.heading }} <span class="tagline-gradient">{{ section.settings.heading_accent }}</span></h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: '/pages/portfolio' }}" class="btn btn-ghost">{{ section.settings.link_label }} &rarr;</a>
      {%- endif -%}
    </div>

    <div class="proof-grid">
      {%- for block in section.blocks -%}
        <div class="proof-cell {% if forloop.first %}wide{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {%- elsif block.settings.asset != blank -%}
            <img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {%- endif -%}
          <div class="cap">
            <div class="t">{{ block.settings.type }}</div>
            <div class="n">{{ block.settings.title }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Proof wall",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Proof wall" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real work," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "real moments." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View full portfolio" },
    { "type": "url", "id": "link_url", "label": "Link url" }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "asset", "label": "Bundled asset filename (fallback)" },
      { "type": "text", "id": "type", "label": "Type" },
      { "type": "text", "id": "title", "label": "Title" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Proof wall" }]
}
{% endschema %}
