<section class="section {{ section.settings.band }}">
  <div class="wrap center" style="max-width:44rem">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="{% if section.settings.band == 'band-cocoa' %}color:var(--blush){% endif %}">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="serif mt-2" style="font-size:clamp(2rem,4.5vw,3.2rem)">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="mt-2 {% unless section.settings.band == 'band-cocoa' %}muted{% endunless %}" style="{% if section.settings.band == 'band-cocoa' %}color:#cdbfb2{% endif %}">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="mt-3"><a href="{{ section.settings.button_url | default: '#' }}" class="btn btn-cta">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text / CTA",
  "settings": [
    { "type": "select", "id": "band", "label": "Background band", "options": [
      { "value": "", "label": "Cream" },
      { "value": "band-blush", "label": "Blush" },
      { "value": "band-sage", "label": "Sage" },
      { "value": "band-mix", "label": "Mixed" },
      { "value": "band-cocoa", "label": "Cocoa (dark)" }
    ], "default": "band-cocoa" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Custom work, clearly scoped" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don't see your exact moment?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every project starts as a conversation. Tell me what you're celebrating and I'll build something around it." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start a Custom Project" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text / CTA" }]
}
{% endschema %}
