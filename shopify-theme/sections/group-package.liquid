<section class="wrap section" style="padding-top:0">
  <div class="card" style="padding:1.5rem">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h3 class="serif mt-1" style="font-size:1.7rem">{{ section.settings.heading }}</h3>
    {%- if section.settings.intro != blank -%}<p class="muted mt-1" style="max-width:38rem">{{ section.settings.intro }}</p>{%- endif -%}
    {%- if section.settings.note != blank -%}<p class="mt-1" style="font-size:.9rem;background:var(--cream);border-radius:1rem;padding:.8rem 1rem">{{ section.settings.note }}</p>{%- endif -%}
    <button type="button" class="btn btn-cta mt-2" onclick="ccPick('{{ section.settings.pick_text | escape }}','Custom Apparel',{{ section.settings.price | default: 175 }})">{{ section.settings.button_label | default: 'Build my group order' }}</button>
  </div>

  {%- if section.blocks.size > 0 -%}
  <div class="grid grid-4 mt-3">
    {%- for block in section.blocks -%}
      <div style="border:1px solid var(--line);background:var(--cream-paper);border-radius:1.25rem;padding:1.1rem" {{ block.shopify_attributes }}>
        <h4 class="serif" style="font-size:1.15rem">{{ block.settings.title }}</h4>
        <p class="muted" style="font-size:.85rem;margin-top:.4rem;line-height:1.55">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Group package",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Group Apparel Package" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Six shirts start the crew." },
    { "type": "textarea", "id": "intro", "label": "Intro text" },
    { "type": "textarea", "id": "note", "label": "Highlighted note" },
    { "type": "number", "id": "price", "label": "Package price (drives the 50% deposit)", "default": 175 },
    { "type": "text", "id": "pick_text", "label": "Text added to the quote form", "default": "Group Apparel Package, $175 (6 adult shirts + one design; list additional adult/youth shirts)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Build my group order" }
  ],
  "blocks": [
    { "type": "tile", "name": "Info tile", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Group package" }]
}
{% endschema %}
