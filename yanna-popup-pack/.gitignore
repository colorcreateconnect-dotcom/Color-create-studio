# Generated GIF + WebM + still overlays ARE committed (they're the deliverables).
#
# PNG sequences are intentionally NOT committed: 150 stickers x dozens of frames
# would be tens of thousands of files. Regenerate any time with:
#   python3 scripts/animate.py --formats png-sequence --category signature
exports/png-sequence/*
!exports/png-sequence/.gitkeep

# self-test scratch + ffmpeg temp frames
**/_selftest_*
**/*_frames_tmp/

# python
__pycache__/
*.pyc
