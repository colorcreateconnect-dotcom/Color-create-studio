# ─── Client (safe to expose; Vite inlines VITE_* into the browser bundle) ───
# The anon/publishable key is RLS-guarded — it can only read/write what policies
# allow. Use the legacy anon key OR the new `sb_publishable_…` key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_SQUARE_APP_ID=sandbox-sq0idb-xxxxxxxx     # Web Payments SDK (tokenization only)
VITE_SQUARE_LOCATION_ID=your-location-id
VITE_MAPBOX_TOKEN=pk.xxxxx                      # or use Google Maps JS key below
# VITE_GOOGLE_MAPS_KEY=

# ─── Server ONLY (Netlify env vars; NEVER prefixed VITE_, never in the browser) ───
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # bypasses RLS — functions only
SQUARE_ACCESS_TOKEN=your-square-access-token         # can charge cards — functions only
SQUARE_ENV=sandbox                                    # sandbox | production
SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key
SQUARE_WEBHOOK_URL=https://your-site.netlify.app/.netlify/functions/square-webhook
# Web Push — how notices reach a phone. No provider, no per-message cost.
# Generate once with:  npx web-push generate-vapid-keys
# With these unset, notices are in-app only and the app never offers to turn
# phone notifications on.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                                    # signs the push — functions only
VAPID_SUBJECT=mailto:ahleyia@atlluxurycleaning.com

# Texting is OPTIONAL and is not part of signing in — everyone signs in with an
# email and a password. Twilio only adds the app being able to text a link or an
# arrival notice as well as notifying in-app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=                                       # or SENDGRID_API_KEY
